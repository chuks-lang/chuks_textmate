// @chuks/textmate — a pure-Chuks TextMate grammar interpreter.
//
// Tokenizes source code into scoped spans using TextMate `.tmLanguage.json`
// grammars, powered by @chuks/pcre (backtracking regex with the lookaround /
// backreferences / `\G` anchor that grammars rely on). This is what drives
// server-side syntax highlighting without Shiki or an oniguruma WASM blob.
//
//   import { Grammar } from "pkg/@chuks/textmate"
//   var g = Grammar.load(grammarJsonString)
//   var state = g.initialState()
//   for (var line of sourceLines) {
//       var r = g.tokenizeLine(line, state)
//       // r.tokens: [{ start, end, scopes: [...] }]  ; r.state carries multiline context
//       state = r.state
//   }
//
// Supported grammar constructs: match rules with captures · begin/end rules
// with begin/end/beginCaptures/endCaptures/contentName and nested patterns ·
// includes ($self, $base, #repository-ref) · the repository · multiline state
// carried across lines · backreference substitution in end patterns (heredocs).

import { json } from "std/json"
import { strings } from "std/strings"
import { Regex, Match } from "pkg/@chuks/pcre"

// ─── Grammar model ───────────────────────────────────────────────────────────

// One node of the grammar. `kind` selects the live fields.
class Rule {
    var kind: string                 // match | beginEnd | include | group
    var name: string                 // scope name applied to the whole match / region
    var contentName: string          // scope name applied to begin/end *content*
    var matchRe: Regex?              // compiled "match"
    var beginRe: Regex?             // compiled "begin"
    var endSource: string            // raw "end" (may contain \1.. backrefs to begin)
    var endRe: Regex?               // compiled "end" when it has no backrefs
    var endHasBackref: bool
    var captures: map[string]string         // group index → scope (match rule)
    var beginCaptures: map[string]string
    var endCaptures: map[string]string
    var patterns: []Rule             // nested / group members
    var includeRef: string           // unresolved include target
    var owner: Grammar?              // the grammar this rule belongs to (for #ref + scopeName)
    var _candidates: []Rule          // cached include-resolved candidate list
    var _resolved: bool

    constructor() {
        this.kind = "group"
        this.name = ""
        this.contentName = ""
        this.matchRe = null
        this.beginRe = null
        this.endSource = ""
        this.endRe = null
        this.endHasBackref = false
        this.captures = {}
        this.beginCaptures = {}
        this.endCaptures = {}
        this.patterns = []
        this.includeRef = ""
        this.owner = null
        this._candidates = []
        this._resolved = false
    }
}

// ─── Output ──────────────────────────────────────────────────────────────────

export class Token {
    var start: int
    var end: int
    var scopes: []string
    constructor(start: int, end: int, scopes: []string) {
        this.start = start
        this.end = end
        this.scopes = scopes
    }
}

// A stack frame for an active begin/end region.
class Frame {
    var rule: Rule
    var endRe: Regex
    var contentScopes: []string   // scopes active for content inside this region
    var endScopes: []string       // scopes active for the end match itself
    constructor(rule: Rule, endRe: Regex, contentScopes: []string, endScopes: []string) {
        this.rule = rule
        this.endRe = endRe
        this.contentScopes = contentScopes
        this.endScopes = endScopes
    }
}

// Opaque multiline state: the rule stack carried between lines.
export class GrammarState {
    var frames: []Frame
    constructor(frames: []Frame) { this.frames = frames }
    public clone(): GrammarState {
        var copy: []Frame = []
        for (var i: int = 0; i < this.frames.length; i = i + 1) { copy.push(this.frames[i]) }
        return new GrammarState(copy)
    }
}

export class LineTokens {
    var tokens: []Token
    var state: GrammarState
    constructor(tokens: []Token, state: GrammarState) {
        this.tokens = tokens
        this.state = state
    }
}

// Internal: the winning candidate at a scan position.
class Candidate {
    var rule: Rule
    var match: Match
    var isEnd: bool
    constructor(rule: Rule, match: Match, isEnd: bool) {
        this.rule = rule
        this.match = match
        this.isEnd = isEnd
    }
}

// ─── Grammar ─────────────────────────────────────────────────────────────────

export class Grammar {
    var scopeName: string
    var rootRule: Rule
    var repository: map[string]Rule
    var registry: GrammarRegistry?    // for resolving external "source.x" includes

    constructor(scopeName: string, rootRule: Rule, repository: map[string]Rule) {
        this.scopeName = scopeName
        this.rootRule = rootRule
        this.repository = repository
        this.registry = null
    }

    public setRegistry(reg: GrammarRegistry): void { this.registry = reg }

    // Parse a .tmLanguage.json string into a Grammar.
    static load(jsonStr: string): Grammar {
        var g: any = json.parse(jsonStr)
        var scopeName: string = ""
        if (g["scopeName"] != null) { scopeName = string(g["scopeName"]) }

        var root: Rule = new Rule()
        root.kind = "group"
        root.patterns = parseRuleList(g["patterns"])

        var repo: map[string]Rule = {}
        var repoAny: any = g["repository"]
        if (repoAny != null) {
            var repoMap: map[string]any = repoAny
            var keys: []string = repoMap.keys()
            for (var i: int = 0; i < keys.length; i = i + 1) {
                var key: string = string(keys[i])
                repo[key] = parseRule(repoMap[key])
            }
        }
        var grammar: Grammar = new Grammar(scopeName, root, repo)
        // Tag every rule with its owning grammar so #ref / external includes and
        // scope resolution use the right context once grammars are composed.
        grammar.assignOwner(root)
        var repoKeys: []string = repo.keys()
        for (var j: int = 0; j < repoKeys.length; j = j + 1) {
            var rr: Rule? = repo.get(repoKeys[j])
            if (rr != null) { grammar.assignOwner(rr) }
        }
        return grammar
    }

    // Recursively stamp `owner` on a rule and everything reachable from it.
    private assignOwner(rule: Rule): void {
        if (rule.owner == this) { return }   // already done (guards cycles)
        rule.owner = this
        for (var i: int = 0; i < rule.patterns.length; i = i + 1) { this.assignOwner(rule.patterns[i]) }
    }

    public initialState(): GrammarState {
        return new GrammarState([])
    }

    // Tokenize one line. `state` carries multiline context in and out.
    public tokenizeLine(line: string, state: GrammarState): LineTokens {
        var tokens: []Token = []
        var frames: []Frame = state.clone().frames
        var lineLen: int = line.length
        var pos: int = 0
        var guard: int = 0

        while (pos <= lineLen) {
            guard = guard + 1
            if (guard > lineLen + 5000) { break }   // safety against pathological loops

            var topRule: Rule = this.topRule(frames)
            var contentScopes: []string = this.currentScopes(frames)
            var best: Candidate? = this.nextMatch(line, pos, frames, topRule)

            if (best == null) {
                if (pos < lineLen) { tokens.push(new Token(pos, lineLen, contentScopes)) }
                break
            }

            var m: Match = best.match
            var mStart: int = m.start()
            var mEnd: int = m.end()

            // text between the cursor and the match keeps the current scopes
            if (mStart > pos) { tokens.push(new Token(pos, mStart, contentScopes)) }

            if (best.isEnd) {
                var top: Frame = frames[frames.length - 1]
                this.emitCaptured(tokens, m, top.rule.endCaptures, top.endScopes)
                frames.pop()
            } else if (best.rule.kind == "match") {
                var rule: Rule = best.rule
                var scopes: []string = this.appendScope(contentScopes, rule.name)
                this.emitCaptured(tokens, m, rule.captures, scopes)
            } else {
                // beginEnd: emit begin captures, push a frame
                var br: Rule = best.rule
                var beginScopes: []string = this.appendScope(contentScopes, br.name)
                this.emitCaptured(tokens, m, br.beginCaptures, beginScopes)
                var newContent: []string = beginScopes
                if (br.contentName != "") { newContent = this.appendScope(beginScopes, br.contentName) }
                var endRe: Regex = this.resolveEnd(br, m)
                frames.push(new Frame(br, endRe, newContent, beginScopes))
            }

            // advance; guard against a zero-width match stalling the scan
            if (mEnd > pos) { pos = mEnd }
            else if (mEnd == pos && mStart == pos) {
                if (best.isEnd || best.rule.kind == "beginEnd") {
                    // stack changed → progress was made, keep pos
                } else {
                    pos = pos + 1
                }
            } else { pos = mEnd }
        }

        return new LineTokens(tokens, new GrammarState(frames))
    }

    // ── scope helpers ────────────────────────────────────────────────────────

    private topRule(frames: []Frame): Rule {
        if (frames.length == 0) { return this.rootRule }
        return frames[frames.length - 1].rule
    }

    private currentScopes(frames: []Frame): []string {
        if (frames.length == 0) {
            if (this.scopeName == "") { return [] }
            return [this.scopeName]
        }
        return frames[frames.length - 1].contentScopes
    }

    private appendScope(base: []string, scope: string): []string {
        if (scope == "") { return base }
        var out: []string = []
        for (var i: int = 0; i < base.length; i = i + 1) { out.push(base[i]) }
        out.push(scope)
        return out
    }

    // ── matching ──────────────────────────────────────────────────────────────

    // Winning candidate at `pos`. The current region's `end` pattern has
    // priority (TextMate's default applyEndPatternLast=false): a child must
    // match STRICTLY before the end to win; on a tie the region closes.
    private nextMatch(line: string, pos: int, frames: []Frame, topRule: Rule): Candidate? {
        var endMatch: Match? = null
        var endStart: int = -1
        var endRule: Rule? = null
        if (frames.length > 0) {
            var top: Frame = frames[frames.length - 1]
            var em: Match? = top.endRe.find(line, pos)
            if (em != null) { endMatch = em; endStart = em.start(); endRule = top.rule }
        }

        var best: Candidate? = null
        var bestStart: int = -1
        var candidates: []Rule = this.candidatesFor(topRule)
        for (var i: int = 0; i < candidates.length; i = i + 1) {
            var c: Rule = candidates[i]
            var re: Regex? = (c.kind == "match") ? c.matchRe : c.beginRe
            if (re == null) { continue }
            var m: Match? = re.find(line, pos)
            if (m == null) { continue }
            var s: int = m.start()
            if (endMatch != null && s >= endStart) { continue }   // end wins ties
            if (best == null || s < bestStart) {
                best = new Candidate(c, m, false)
                bestStart = s
                if (s == pos) { break }   // can't beat a match at the cursor
            }
        }

        if (best != null) { return best }
        if (endMatch != null && endRule != null) { return new Candidate(endRule, endMatch, true) }
        return null
    }

    // Include-resolved candidate list for a rule, cached on the rule. Resolution
    // happens in the rule's OWNER grammar so #ref hits the right repository and
    // external "source.x" includes pull from the registry's other grammars.
    private candidatesFor(rule: Rule): []Rule {
        if (rule._resolved) { return rule._candidates }
        var ownerOpt: Grammar? = rule.owner
        var owner: Grammar = ownerOpt == null ? this : ownerOpt
        var out: []Rule = []
        var visited: map[string]bool = {}
        owner.collect(owner, rule.patterns, out, visited)
        rule._candidates = out
        rule._resolved = true
        return out
    }

    // collect/resolveInclude carry the grammar that OWNS the patterns being
    // walked, so a #ref always resolves against that grammar's repository even
    // when its rules were spliced into another grammar via an external include.
    private collect(owner: Grammar, patterns: []Rule, out: []Rule, visited: map[string]bool) {
        for (var i: int = 0; i < patterns.length; i = i + 1) {
            var p: Rule = patterns[i]
            if (p.kind == "include") {
                owner.resolveInclude(owner, p.includeRef, out, visited)
            } else if (p.kind == "group") {
                owner.collect(owner, p.patterns, out, visited)
            } else {
                out.push(p)   // match or beginEnd → a real candidate
            }
        }
    }

    private resolveInclude(owner: Grammar, ref: string, out: []Rule, visited: map[string]bool) {
        if (ref == "") { return }
        var visitKey: string = owner.scopeName + "|" + ref
        if (visited.get(visitKey) == true) { return }
        visited[visitKey] = true
        if (ref == "$self" || ref == "$base") {
            owner.collect(owner, owner.rootRule.patterns, out, visited)
            return
        }
        if (strings.charAt(ref, 0) == "#") {
            var name: string = strings.substring(ref, 1, ref.length)
            var target: Rule? = owner.repository.get(name)
            if (target == null) { return }
            var t: Rule = target
            if (t.kind == "group") { owner.collect(owner, t.patterns, out, visited) }
            else if (t.kind == "include") { owner.resolveInclude(owner, t.includeRef, out, visited) }
            else { out.push(t) }
            return
        }
        // External grammar scope, e.g. "source.css" or "text.html.basic#rule".
        // Resolve via the shared registry; an optional "#rule" selects one rule.
        var reg: GrammarRegistry? = owner.registry
        if (reg == null) { return }
        var scopePart: string = ref
        var rulePart: string = ""
        var hashAt: int = strings.indexOf(ref, "#")
        if (hashAt >= 0) {
            scopePart = strings.substring(ref, 0, hashAt)
            rulePart = strings.substring(ref, hashAt + 1, ref.length)
        }
        var ext: Grammar? = reg.get(scopePart)
        if (ext == null) { return }
        var extG: Grammar = ext
        if (rulePart == "") {
            extG.collect(extG, extG.rootRule.patterns, out, visited)
        } else {
            var er: Rule? = extG.repository.get(rulePart)
            if (er == null) { return }
            var ert: Rule = er
            if (ert.kind == "group") { extG.collect(extG, ert.patterns, out, visited) }
            else { out.push(ert) }
        }
    }

    // Compile the end pattern for a freshly-entered region, substituting any
    // \1..\9 backreferences with the literal text the begin match captured.
    private resolveEnd(rule: Rule, beginMatch: Match): Regex {
        if (!rule.endHasBackref) {
            if (rule.endRe != null) { return rule.endRe }
            return new Regex(rule.endSource)
        }
        var substituted: string = substituteBackrefs(rule.endSource, beginMatch)
        return new Regex(substituted)
    }

    // ── capture emission ───────────────────────────────────────────────────────

    // Emit tokens for a match, splitting out numbered capture groups. Captures
    // are assumed non-overlapping and left-to-right (true for typical grammars).
    private emitCaptured(tokens: []Token, m: Match, caps: map[string]string, baseScopes: []string) {
        var start: int = m.start()
        var end: int = m.end()
        if (end <= start) { return }

        var capKeys: []string = caps.keys()
        if (capKeys.length == 0) {
            tokens.push(new Token(start, end, baseScopes))
            return
        }

        var cursor: int = start
        var maxGroup: int = m.groupCount()
        for (var g: int = 1; g <= maxGroup; g = g + 1) {
            var scope: string? = caps.get(string(g))
            if (scope == null) { continue }
            var sp: []int = m.span(g)
            if (sp[0] < 0 || sp[1] <= sp[0]) { continue }
            if (sp[0] < cursor) { continue }   // skip overlaps we can't represent
            if (sp[0] > cursor) { tokens.push(new Token(cursor, sp[0], baseScopes)) }
            var capScopes: []string = this.appendScope(baseScopes, scope)
            tokens.push(new Token(sp[0], sp[1], capScopes))
            cursor = sp[1]
        }
        // group 0 scope (the whole-match "name") for any leftover region
        if (cursor < end) { tokens.push(new Token(cursor, end, baseScopes)) }
    }
}

// ─── GrammarRegistry (cross-grammar / embedded languages) ────────────────────
// Holds grammars by scopeName so one grammar can embed another via an external
// include (e.g. HTML's <style> block includes "source.css", markdown fences
// include "source.js"). Add every grammar a document might reference, then use
// any of them to tokenize — external includes resolve through the registry.

export class GrammarRegistry {
    var _byScope: map[string]Grammar

    constructor() { this._byScope = {} }

    // Register a grammar (keyed by its scopeName) and wire it to this registry.
    public add(grammar: Grammar): void {
        this._byScope[grammar.scopeName] = grammar
        grammar.setRegistry(this)
    }

    // Parse + register a grammar JSON in one step; returns it.
    public load(jsonStr: string): Grammar {
        var g: Grammar = Grammar.load(jsonStr)
        this.add(g)
        return g
    }

    public get(scopeName: string): Grammar? { return this._byScope.get(scopeName) }
    public has(scopeName: string): bool { return this._byScope.get(scopeName) != null }
}

// ─── JSON → Rule parsing (free functions) ────────────────────────────────────

function parseRuleList(arr: any): []Rule {
    var out: []Rule = []
    if (arr == null) { return out }
    var items: []any = arr
    for (var i: int = 0; i < items.length; i = i + 1) {
        out.push(parseRule(items[i]))
    }
    return out
}

function parseRule(r: any): Rule {
    var rule: Rule = new Rule()
    if (r == null) { return rule }

    if (r["include"] != null) {
        rule.kind = "include"
        rule.includeRef = string(r["include"])
        return rule
    }

    if (r["name"] != null) { rule.name = string(r["name"]) }
    if (r["contentName"] != null) { rule.contentName = string(r["contentName"]) }

    if (r["match"] != null) {
        rule.kind = "match"
        rule.matchRe = tryCompile(string(r["match"]))
        // An uncompilable pattern (rare oniguruma feature) degrades to a
        // no-op rule rather than crashing the whole grammar.
        if (rule.matchRe == null) { rule.kind = "group" }
        rule.captures = parseCaptures(r["captures"])
        return rule
    }

    if (r["begin"] != null) {
        rule.kind = "beginEnd"
        rule.beginRe = tryCompile(string(r["begin"]))
        rule.beginCaptures = parseCaptures(r["beginCaptures"])
        // a shared "captures" applies to both begin and end when the specific
        // ones are absent
        var shared: map[string]string = parseCaptures(r["captures"])
        if (rule.beginCaptures.keys().length == 0) { rule.beginCaptures = shared }
        if (r["end"] != null) {
            rule.endSource = string(r["end"])
            rule.endHasBackref = hasBackref(rule.endSource)
            if (!rule.endHasBackref) {
                rule.endRe = tryCompile(rule.endSource)
                if (rule.endRe == null) { rule.beginRe = null }   // can't honor it → drop rule
            }
        }
        rule.endCaptures = parseCaptures(r["endCaptures"])
        if (rule.endCaptures.keys().length == 0) { rule.endCaptures = shared }
        rule.patterns = parseRuleList(r["patterns"])
        // If begin (or its end) wouldn't compile, neutralize the rule.
        if (rule.beginRe == null) { rule.kind = "group"; rule.patterns = [] }
        return rule
    }

    // group: just nested patterns
    rule.kind = "group"
    rule.patterns = parseRuleList(r["patterns"])
    return rule
}

// Compile a regex, returning null instead of throwing when the pattern uses an
// oniguruma feature @chuks/pcre doesn't support. Lets a single odd rule degrade
// gracefully instead of taking down the whole grammar.
function tryCompile(pattern: string): Regex? {
    try {
        return new Regex(pattern)
    } catch (e: Error) {
        return null
    }
}

// captures: { "1": { "name": "scope" }, ... } → { "1": "scope" }
function parseCaptures(c: any): map[string]string {
    var out: map[string]string = {}
    if (c == null) { return out }
    var cm: map[string]any = c
    var keys: []string = cm.keys()
    for (var i: int = 0; i < keys.length; i = i + 1) {
        var k: string = string(keys[i])
        var entry: any = cm[k]
        if (entry == null) { continue }
        if (typeof(entry) == "string") { out[k] = string(entry); continue }   // shorthand form
        if (typeof(entry) == "map" && entry["name"] != null) { out[k] = string(entry["name"]) }
    }
    return out
}

function hasBackref(src: string): bool {
    var n: int = src.length
    for (var i: int = 0; i < n - 1; i = i + 1) {
        if (strings.charAt(src, i) == "\\") {
            var c: string = strings.charAt(src, i + 1)
            if (c >= "1" && c <= "9") { return true }
        }
    }
    return false
}

// Replace \1..\9 in an end pattern with the regex-escaped text of the begin
// match's corresponding capture group.
function substituteBackrefs(src: string, m: Match): string {
    var out: string = ""
    var n: int = src.length
    var i: int = 0
    while (i < n) {
        var c: string = strings.charAt(src, i)
        if (c == "\\" && i + 1 < n) {
            var d: string = strings.charAt(src, i + 1)
            if (d >= "1" && d <= "9") {
                var g: int = int(d)
                out = out + escapeRegex(m.group(g))
                i = i + 2
                continue
            }
            out = out + c + d
            i = i + 2
            continue
        }
        out = out + c
        i = i + 1
    }
    return out
}

function escapeRegex(s: string): string {
    var out: string = ""
    var n: int = s.length
    for (var i: int = 0; i < n; i = i + 1) {
        var c: string = strings.charAt(s, i)
        if (c == "\\" || c == "." || c == "*" || c == "+" || c == "?" || c == "(" || c == ")" ||
            c == "[" || c == "]" || c == "{" || c == "}" || c == "^" || c == "$" || c == "|" || c == "/") {
            out = out + "\\"
        }
        out = out + c
    }
    return out
}

// ─── Theme (scope → color/style resolution) ──────────────────────────────────
// The second half of a syntax highlighter: a TextMate/VS Code theme maps a
// token's scope stack to a foreground color and font style. Together with the
// grammar tokenizer above, this is a full Shiki-equivalent in pure Chuks.

export class Style {
    var foreground: string   // "#rrggbb" or "" when unset
    var bold: bool
    var italic: bool
    var underline: bool
    constructor(foreground: string, bold: bool, italic: bool, underline: bool) {
        this.foreground = foreground
        this.bold = bold
        this.italic = italic
        this.underline = underline
    }
}

// One parsed tokenColors entry.
class ThemeRule {
    var selectors: []string  // scope selectors (each may be a space-separated descendant path)
    var foreground: string
    var hasStyle: bool
    var bold: bool
    var italic: bool
    var underline: bool
    constructor() {
        this.selectors = []
        this.foreground = ""
        this.hasStyle = false
        this.bold = false
        this.italic = false
        this.underline = false
    }
}

export class Theme {
    var name: string
    var type: string            // "dark" | "light"
    var _defaultFg: string
    var _defaultBg: string
    var _rules: []ThemeRule

    constructor(name: string, type: string, defaultFg: string, defaultBg: string, rules: []ThemeRule) {
        this.name = name
        this.type = type
        this._defaultFg = defaultFg
        this._defaultBg = defaultBg
        this._rules = rules
    }

    public defaultForeground(): string { return this._defaultFg }
    public background(): string { return this._defaultBg }

    // Parse a VS Code / TextMate theme JSON (the shape Shiki ships).
    static load(jsonStr: string): Theme {
        var t: any = json.parse(jsonStr)
        var name: string = t["name"] != null ? string(t["name"]) : ""
        var type: string = t["type"] != null ? string(t["type"]) : "dark"

        var colors: any = t["colors"]
        var defaultFg: string = "#e5e7eb"
        var defaultBg: string = "#1e1e1e"
        if (t["fg"] != null && string(t["fg"]) != "") { defaultFg = string(t["fg"]) }
        else if (colors != null && colors["editor.foreground"] != null) { defaultFg = string(colors["editor.foreground"]) }
        if (t["bg"] != null && string(t["bg"]) != "") { defaultBg = string(t["bg"]) }
        else if (colors != null && colors["editor.background"] != null) { defaultBg = string(colors["editor.background"]) }

        var rules: []ThemeRule = []
        var tc: any = t["tokenColors"]
        if (tc != null) {
            var items: []any = tc
            for (var i: int = 0; i < items.length; i = i + 1) {
                var entry: any = items[i]
                var settings: any = entry["settings"]
                if (settings == null) { continue }
                var rule: ThemeRule = new ThemeRule()
                if (settings["foreground"] != null) { rule.foreground = string(settings["foreground"]) }
                if (settings["fontStyle"] != null) {
                    rule.hasStyle = true
                    var fs: string = string(settings["fontStyle"])
                    rule.bold = strings.contains(fs, "bold")
                    rule.italic = strings.contains(fs, "italic")
                    rule.underline = strings.contains(fs, "underline")
                }
                var scopeAny: any = entry["scope"]
                rule.selectors = normalizeScope(scopeAny)
                if (rule.selectors.length == 0) {
                    // A settings entry with no scope is the theme default.
                    if (rule.foreground != "") { defaultFg = rule.foreground }
                    continue
                }
                rules.push(rule)
            }
        }
        return new Theme(name, type, defaultFg, defaultBg, rules)
    }

    // Resolve the style for a token's scope stack (root → most specific).
    public resolve(scopes: []string): Style {
        var fg: string = this._defaultFg
        var bold: bool = false
        var italic: bool = false
        var underline: bool = false
        var bestFg: int = 0
        var bestStyle: int = 0

        for (var i: int = 0; i < this._rules.length; i = i + 1) {
            var rule: ThemeRule = this._rules[i]
            var score: int = 0
            for (var s: int = 0; s < rule.selectors.length; s = s + 1) {
                var sc: int = selectorScore(rule.selectors[s], scopes)
                if (sc > score) { score = sc }
            }
            if (score == 0) { continue }
            // Ties go to later rules (VS Code semantics): use >=.
            if (rule.foreground != "" && score >= bestFg) { bestFg = score; fg = rule.foreground }
            if (rule.hasStyle && score >= bestStyle) {
                bestStyle = score; bold = rule.bold; italic = rule.italic; underline = rule.underline
            }
        }
        return new Style(fg, bold, italic, underline)
    }
}

// scope can be a string ("a, b") or an array of strings. Returns the selectors.
function normalizeScope(scopeAny: any): []string {
    var out: []string = []
    if (scopeAny == null) { return out }
    if (typeof(scopeAny) == "array") {
        var items: []any = scopeAny
        for (var i: int = 0; i < items.length; i = i + 1) {
            splitSelectors(string(items[i]), out)
        }
    } else {
        splitSelectors(string(scopeAny), out)
    }
    return out
}

function splitSelectors(raw: string, out: []string) {
    // A scope string may hold comma-separated selectors.
    var parts: []string = strings.split(raw, ",")
    for (var i: int = 0; i < parts.length; i = i + 1) {
        var p: string = strings.trim(parts[i])
        if (p != "") { out.push(p) }
    }
}

// Score how well a selector matches a scope stack. 0 = no match; higher = more
// specific. A selector is a space-separated descendant path; each part matches a
// scope if it equals it or is a dotted prefix of it. Parts must match in
// ancestor order, with the last part deepest.
function selectorScore(selector: string, scopes: []string): int {
    var parts: []string = []
    var raw: []string = strings.split(selector, " ")
    for (var i: int = 0; i < raw.length; i = i + 1) {
        var p: string = strings.trim(raw[i])
        if (p != "") { parts.push(p) }
    }
    if (parts.length == 0) { return 0 }

    var partIdx: int = parts.length - 1
    var scopeIdx: int = scopes.length - 1
    var deepest: int = -1
    while (partIdx >= 0 && scopeIdx >= 0) {
        if (scopeSelectorMatches(scopes[scopeIdx], parts[partIdx])) {
            if (deepest < 0) { deepest = scopeIdx }
            partIdx = partIdx - 1
            scopeIdx = scopeIdx - 1
        } else {
            scopeIdx = scopeIdx - 1
        }
    }
    if (partIdx >= 0) { return 0 }   // some part never matched

    var specificity: int = 0
    for (var k: int = 0; k < parts.length; k = k + 1) { specificity = specificity + segmentCount(parts[k]) }
    return specificity * 10000 + (deepest + 1)
}

function scopeSelectorMatches(scope: string, sel: string): bool {
    if (scope == sel) { return true }
    return strings.startsWith(scope, sel + ".")
}

function segmentCount(s: string): int {
    var n: int = 1
    for (var i: int = 0; i < s.length; i = i + 1) {
        if (strings.charAt(s, i) == ".") { n = n + 1 }
    }
    return n
}

// ─── Highlighter (grammar + theme → styled tokens) ───────────────────────────

export class StyledToken {
    var start: int
    var end: int
    var text: string
    var foreground: string
    var bold: bool
    var italic: bool
    constructor(start: int, end: int, text: string, foreground: string, bold: bool, italic: bool) {
        this.start = start
        this.end = end
        this.text = text
        this.foreground = foreground
        this.bold = bold
        this.italic = italic
    }
}

export class StyledLine {
    var tokens: []StyledToken
    var state: GrammarState
    constructor(tokens: []StyledToken, state: GrammarState) {
        this.tokens = tokens
        this.state = state
    }
}

// Ties a grammar to a theme. highlightLine returns drawable tokens — text +
// color + font style — exactly what a canvas/HTML renderer consumes.
export class Highlighter {
    var grammar: Grammar
    var theme: Theme
    constructor(grammar: Grammar, theme: Theme) {
        this.grammar = grammar
        this.theme = theme
    }

    public initialState(): GrammarState { return this.grammar.initialState() }
    public defaultForeground(): string { return this.theme.defaultForeground() }
    public background(): string { return this.theme.background() }

    public highlightLine(line: string, state: GrammarState): StyledLine {
        var lt: LineTokens = this.grammar.tokenizeLine(line, state)
        var out: []StyledToken = []
        for (var i: int = 0; i < lt.tokens.length; i = i + 1) {
            var t: Token = lt.tokens[i]
            var st: Style = this.theme.resolve(t.scopes)
            var text: string = strings.substring(line, t.start, t.end)
            out.push(new StyledToken(t.start, t.end, text, st.foreground, st.bold, st.italic))
        }
        return new StyledLine(out, lt.state)
    }
}
